# Fire TV IP address (optional for startup; required for control tools)
FIRETV_IP=192.168.1.102

# ADB port (optional, default 5555)
FIRETV_PORT=5555

# Optional tuning values
# Timeout for individual adb commands in ms (default 30000)
FIRETV_ADB_COMMAND_TIMEOUT_MS=30000
# Number of connect retries for transient network failures (default 3)
FIRETV_ADB_CONNECT_RETRIES=3
# Backoff base for connect retries in ms (default 500)
FIRETV_ADB_RETRY_BASE_DELAY_MS=500
# Number of shell attempts before failing (default 2)
FIRETV_ADB_SHELL_ATTEMPTS=2
# Maximum allowed delay for press_keys tool in ms (default 5000)
FIRETV_PRESS_KEYS_DELAY_MAX_MS=5000
