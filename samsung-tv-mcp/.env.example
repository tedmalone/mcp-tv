# Samsung TV MCP Server Configuration
# Copy to .env and fill in values

# Samsung TV IP address (optional for startup; required for control tools)
SAMSUNG_TV_IP=192.168.1.100

# Samsung TV MAC address for Wake-on-LAN fallback (auto-saved by discover tool)
SAMSUNG_TV_MAC=AA:BB:CC:DD:EE:FF

# Display name shown on TV permission prompt (optional, default: "Claude MCP")
SAMSUNG_TV_NAME=Claude MCP

# Auth token from TV WebSocket (auto-populated after first connection and approval)
SAMSUNG_TV_TOKEN=

# ─── SmartThings (recommended) ────────────────────────────────────────────────
# Enables reliable power-on and direct input switching (KEY_HDMIx ignored on 2024+ TVs).
# Get token at: https://account.smartthings.com/tokens
# Get device ID: GET https://api.smartthings.com/v1/devices (with Bearer token)
SAMSUNG_SMARTTHINGS_TOKEN=
SAMSUNG_SMARTTHINGS_DEVICE_ID=

# SmartThings API base URL (optional, default: https://api.smartthings.com/v1)
# SAMSUNG_SMARTTHINGS_API_URL=https://api.smartthings.com/v1

# ─── Wake-on-LAN tuning ───────────────────────────────────────────────────────
# Override broadcast address (default: TV subnet broadcast, e.g. 192.168.1.255)
# SAMSUNG_TV_WOL_BROADCAST=192.168.1.255

# ─── Optional tuning ──────────────────────────────────────────────────────────
# Samsung WebSocket control API port (default 8002)
SAMSUNG_TV_WS_PORT=8002
# Samsung REST API port (default 8001)
SAMSUNG_TV_REST_PORT=8001
# Connect timeout for WS handshake (default 5000)
SAMSUNG_TV_CONNECT_TIMEOUT_MS=5000
# Delay between key presses to avoid dropped input (default 150)
SAMSUNG_TV_COMMAND_SETTLE_MS=150
# Retry attempts for WS connect (default 3)
SAMSUNG_TV_CONNECT_RETRIES=3
# Backoff base for WS reconnect in ms (default 500)
SAMSUNG_TV_CONNECT_RETRY_BASE_DELAY_MS=500
# REST device info timeout in ms (default 3000)
SAMSUNG_TV_DEVICE_INFO_TIMEOUT_MS=3000
# REST device info retry attempts (default 2)
SAMSUNG_TV_DEVICE_INFO_RETRIES=2
# Delay between REST retries in ms (default 400)
SAMSUNG_TV_DEVICE_INFO_RETRY_DELAY_MS=400
# Discovery scan concurrency (default 24)
SAMSUNG_TV_DISCOVERY_CONCURRENCY=24
# Discovery per-host timeout in ms (default 1200)
SAMSUNG_TV_DISCOVERY_TIMEOUT_MS=1200
# Discovery host range defaults (1..254)
SAMSUNG_TV_DISCOVERY_SCAN_START=1
SAMSUNG_TV_DISCOVERY_SCAN_END=254
