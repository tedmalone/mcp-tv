# Apple TV MCP Server Configuration
# Copy to .env and fill in values

# Apple TV IP address (optional — will auto-discover on LAN if omitted)
ATV_IP=192.168.1.101

# Apple TV name for discovery filtering (optional)
ATV_NAME=

# Stored credentials from pairing (auto-populated after first pairing)
# Format: protocol:credentials (one per line, comma-separated)
ATV_CREDENTIALS=

# Optional tuning values
# Apple TV discovery timeout in seconds (default 5)
ATV_DISCOVERY_TIMEOUT_SECONDS=5
# Retry attempts for connect/pair/discovery (defaults: 3/2/2)
ATV_CONNECT_RETRIES=3
ATV_PAIR_RETRIES=2
ATV_DISCOVERY_RETRIES=2
# Retry backoff base in seconds (default 0.5)
ATV_RETRY_BASE_DELAY_SECONDS=0.5
