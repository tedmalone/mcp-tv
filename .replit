modules = ["nodejs-20", "python-3.12"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd fire-tv-mcp && npm run build && echo '=== fire-tv-mcp built ===' && cd ../samsung-tv-mcp && npm run build && echo '=== samsung-tv-mcp built ===' && echo '=== All MCP servers ready. Use node fire-tv-mcp/dist/index.js or node samsung-tv-mcp/dist/index.js to run ==='"

[workflows.workflow.metadata]
outputType = "console"

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "echo 'mcp-tv MCP servers built and ready. Run fire-tv-mcp/dist/index.js, samsung-tv-mcp/dist/index.js, or apple-tv-mcp with python -m apple_tv_mcp.server'"]
build = ["bash", "-c", "cd fire-tv-mcp && npm install && npm run build && cd ../samsung-tv-mcp && npm install && npm run build && cd ../apple-tv-mcp && pip install -e ."]
